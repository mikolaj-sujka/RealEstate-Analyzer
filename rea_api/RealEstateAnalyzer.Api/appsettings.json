{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // "System.Net.Http.HttpClient.otodom": "Trace"
    }
  },
  "Hangfire": {
    "Enabled": true,
    "LongRunningQueueWorkersCount": 3,
    "Crons": "0 0 * * *"
  },
  "HangfireDashboard": {
    "Password": "admin",
    "User": "admin"
  },
  "Database": {
    "ConnectionString": "Server=localhost;Database=rea-local;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=false;TrustServerCertificate=True"
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379",
    "InstanceName": "RealEstateAnalyzer"
  },
  "CsvSettings": {
    "GusHousingDirectory": "RealEstateAnalyzer-Csv-Files"
  },
  "Scraper": {
    "BaseUrl": "https://www.otodom.pl/pl/wyniki/sprzedaz/mieszkanie/cala-polska",
    "DelayMsBetweenPages": "1000",
    "MaxPagesToScrape": 5000,
    "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) OtodomScraper/1.0"
  },
  "AllowedHosts": "*"
}
