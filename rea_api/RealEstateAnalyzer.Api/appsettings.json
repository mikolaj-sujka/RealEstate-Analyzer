{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
      // "System.Net.Http.HttpClient.otodom": "Trace"
    }
  },
  "Hangfire": {
    "Enabled": true,
    "LongRunningQueueWorkersCount": 3,
    "SyncOtodom": "0 1 * * *"
  },
  "HangfireDashboard": {
    "Password": "admin",
    "User": "admin"
  },
  "Database": {
    "ConnectionString": "Server=localhost;Database=rea-local;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=false;TrustServerCertificate=True"
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379",
    "InstanceName": "RealEstateAnalyzer"
  },
  "CsvSettings": {
    "GusHousingDirectory": "RealEstateAnalyzer-Csv-Files"
  },
  "Scraper": {
    "BaseUrl": "https://www.otodom.pl/pl/wyniki/sprzedaz/mieszkanie/cala-polska",
    "MaxPagesToScrape": 1000,
    "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) OtodomScraper/1.0",
    "RetryCount": 3,
    "MinJitterMs": 200,
    "MaxJitterMs": 700,
    "MaxParallelRequests": 6
  },
  "AllowedHosts": "*",
  "CorsPolicyName": {
    "Name": "RealEstateAnalyzerCorsPolicy",
    "Origins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5000",
      "https://localhost:5000"
    ],
    "Methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "Headers": [
      "Content-Type",
      "Authorization"
    ]
  }
}
