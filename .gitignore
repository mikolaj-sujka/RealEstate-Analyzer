# -------------------------------
# .NET / ASP.NET Core
# -------------------------------

# Foldery z wynikami kompilacji
bin/
obj/

# Pliki konfiguracyjne i tymczasowe Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# NuGet packages
*.nupkg
**/packages/*

# Pliki cache systemu Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Pliki logów
*.log

# Pliki związane z konfiguracją środowiska (opcjonalnie)
appsettings.Development.json
appsettings.Local.json

# Plik z tajnymi danymi (np. w przypadku korzystania z Secret Managera)
secrets.json

# -------------------------------
# Frontend - Next.js / Node.js
# -------------------------------

# Folder z modułami Node.js
node_modules/

# Pliki logów npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Foldery build'ów Next.js
.next/
out/

# Pliki środowiskowe
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Edytory i IDE (przykładowo VS Code)
.vscode/
